# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Service role key — server-side only, NEVER expose to the browser
# Required for admin operations that bypass RLS (e.g. user management)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true to allow /admin/register in production (off by default)
# ALLOW_ADMIN_REGISTER=true
# Mock checkout: only when PAYSTACK_SECRET_KEY is unset, and never in production.
# Set false to return 503 instead of mock when Paystack keys are missing.
# ALLOW_MOCK_CHECKOUT=false
# After pull: apply supabase/migrations/026_*.sql through 031_*.sql on your Supabase project
# (test 031 on a local or staging project first: see README "Security").

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Strongly recommended in production. Without these, limits are per server
# instance only (each Vercel instance has its own counter).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── Payment ──────────────────────────────────────────────────────────────────
# Paystack
# Server-side only. Also used to verify webhook signatures (x-paystack-signature).
PAYSTACK_SECRET_KEY=sk_test_xxxx

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
# Until your domain is verified in Resend, use the test sender:
EMAIL_FROM=HAYDA SKINCo. <onboarding@resend.dev>
# Inbox for contact/wholesale notifies (must be your Resend account email while unverified)
EMAIL_TO=your-resend-account-email@example.com

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=2348137309609
