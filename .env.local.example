# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Service role key — server-side only, NEVER expose to the browser
# Required for admin operations that bypass RLS (e.g. user management)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true to allow /admin/register in production (off by default)
# ALLOW_ADMIN_REGISTER=true
# Mock checkout (no Paystack) is allowed only in non-production. Set false to force Paystack locally.
# ALLOW_MOCK_CHECKOUT=false
# After pull: apply supabase/migrations/026_*.sql, 027_*.sql, and 028_*.sql on your Supabase project.
# Optional cron (service role): select public.release_stale_stock_holds(); — frees unpaid holds > 2h.

# ─── Rate limiting (optional Upstash) ─────────────────────────────────────────
# Without these, APIs use an in-memory limiter (fine for local / single instance).
# Free Redis at https://upstash.com — set both for shared limits across Vercel instances.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxx

# ─── Payment ──────────────────────────────────────────────────────────────────
# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxx

# Flutterwave (optional alternative)
FLW_SECRET_KEY=FLWSECK_TEST-xxxx
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxx

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
# Until your domain is verified in Resend, use the test sender:
EMAIL_FROM=HAYDA SKINCo. <onboarding@resend.dev>
# Inbox for contact/wholesale notifies (must be your Resend account email while unverified)
EMAIL_TO=your-resend-account-email@example.com

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=2348137309609
